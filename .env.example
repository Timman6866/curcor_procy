# Required. User or service-account key from https://cursor.com/dashboard/api
CURSOR_API_KEY=

# Optional. OpenAI REST clients must send this Bearer token when set.
# Leave empty to accept the Cursor key as the Bearer token.
PROXY_API_KEY=

# Optional. Bearer token for sdk.v1 Connect RPCs on this proxy.
# If empty, a random token is generated at startup and logged once.
CONNECT_AUTH_TOKEN=

PORT=8787
# Use 127.0.0.1 for local dev. Docker compose sets 0.0.0.0 automatically.
HOST=127.0.0.1

# Used when the request omits `model`, or sends gpt-* placeholders.
DEFAULT_MODEL=composer-2.5

# local = run on this machine (default). cloud = Cursor-hosted VM.
# Docker compose mounts the host Cursor agent for local runtime.
CURSOR_RUNTIME=local

# Host paths used by docker compose (see docker-compose.yml).
# CURSOR_AGENT_DIR=/home/you/.local/share/cursor-agent
# CURSOR_WORKSPACE=.

# Tool policy: full | none | read,grep,shell (local only)
CURSOR_TOOLS=full

# Working directory for bare-metal runs. Docker compose sets /workspace.
CURSOR_CWD=

# Admin web UI (http://HOST:PORT/admin). Disabled when ADMIN_PASSWORD is unset.
# Runtime overrides from the UI are saved to proxy-settings.json in CURSOR_CWD.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Zenflow compat provider (see scripts/zenflow-smoke.sh)
# COMPAT_BASE_URL=http://127.0.0.1:8787/v1
# COMPAT_API_KEY=
