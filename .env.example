# Required. User or service-account key from https://cursor.com/dashboard/api
CURSOR_API_KEY=

# Optional. OpenAI REST clients must send this Bearer token when set.
# Leave empty to accept the Cursor key as the Bearer token.
PROXY_API_KEY=

# Optional. Bearer token for sdk.v1 Connect RPCs on this proxy.
# If empty, a random token is generated at startup and logged once.
CONNECT_AUTH_TOKEN=

PORT=8787
# Use 127.0.0.1 for local dev. Docker compose sets 0.0.0.0 automatically.
HOST=127.0.0.1

# Used when the request omits `model`, or sends gpt-* placeholders.
DEFAULT_MODEL=composer-2.5

# local = run on this machine (default). cloud = Cursor-hosted VM.
# Docker defaults to cloud (local agent executors are not available in-container).
CURSOR_RUNTIME=local

# Working directory for local agents. Defaults to ./.scratch
CURSOR_CWD=
